# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Semua variabel bersifat opsional — jika kosong, CTA terkait menunjuk ke "#".

# URL aplikasi web ARTO (tujuan tombol "Gunakan ARTO Web")
VITE_WEB_APP_URL=

# URL download APK Android ARTO Mobile (tujuan tombol download)
VITE_MOBILE_APK_URL=

# URL Expo client ARTO Mobile (opsional)
VITE_EXPO_URL=
